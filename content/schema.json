{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-(s|v)$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Term as printed on the booklet, e.g. 'Maj-juni 2024'"
    },
    "format": {
      "type": "string",
      "enum": [
        "current",
        "legacy-description"
      ],
      "description": "current: from May–June 2023 (no picture description). legacy-description: before that (candidate first described both pictures)."
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "topics": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "letter": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "da": {
                "type": "string",
                "minLength": 1,
                "description": "Exact Danish wording from the examiner booklet"
              },
              "en": {
                "description": "English translation",
                "type": "string"
              }
            },
            "required": [
              "da"
            ],
            "description": "Topic title, e.g. 'Mangel på arbejdskraft'"
          },
          "picture": {
            "description": "The official sheet with the two pictures",
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^\\/sets\\/[a-z0-9-]+\\/[a-z0-9-]+\\.(webp|png|jpg)$"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "width",
              "height",
              "alt"
            ]
          },
          "situations": {
            "description": "Picture captions, if the sheet has them",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B"
                  ]
                },
                "caption": {
                  "type": "object",
                  "properties": {
                    "da": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact Danish wording from the examiner booklet"
                    },
                    "en": {
                      "description": "English translation",
                      "type": "string"
                    }
                  },
                  "required": [
                    "da"
                  ]
                },
                "description": {
                  "description": "What the picture shows (used as alt text)",
                  "type": "object",
                  "properties": {
                    "da": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact Danish wording from the examiner booklet"
                    },
                    "en": {
                      "description": "English translation",
                      "type": "string"
                    }
                  },
                  "required": [
                    "da"
                  ]
                }
              },
              "required": [
                "label",
                "caption"
              ]
            }
          },
          "firstQuestion": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B"
                  ]
                },
                "intro": {
                  "description": "'Situation A viser …' (current format only)",
                  "type": "object",
                  "properties": {
                    "da": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact Danish wording from the examiner booklet"
                    },
                    "en": {
                      "description": "English translation",
                      "type": "string"
                    }
                  },
                  "required": [
                    "da"
                  ]
                },
                "question": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Stable id within the topic, e.g. 'q1-a', 'q1-a-f1', 'q2', 'q2-f1'"
                    },
                    "da": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact Danish wording from the examiner booklet"
                    },
                    "en": {
                      "description": "English translation",
                      "type": "string"
                    },
                    "answer": {
                      "type": "object",
                      "properties": {
                        "sentences": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "Danish answer, one sentence per item"
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "description": "English translation of the whole answer"
                        },
                        "status": {
                          "default": "draft",
                          "description": "Set to 'reviewed' after the Danish reviewer has checked it",
                          "type": "string",
                          "enum": [
                            "draft",
                            "reviewed"
                          ]
                        }
                      },
                      "required": [
                        "sentences",
                        "en"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "da"
                  ]
                },
                "followUps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "description": "Stable id within the topic, e.g. 'q1-a', 'q1-a-f1', 'q2', 'q2-f1'"
                      },
                      "da": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Exact Danish wording from the examiner booklet"
                      },
                      "en": {
                        "description": "English translation",
                        "type": "string"
                      },
                      "answer": {
                        "type": "object",
                        "properties": {
                          "sentences": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "description": "Danish answer, one sentence per item"
                          },
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "description": "English translation of the whole answer"
                          },
                          "status": {
                            "default": "draft",
                            "description": "Set to 'reviewed' after the Danish reviewer has checked it",
                            "type": "string",
                            "enum": [
                              "draft",
                              "reviewed"
                            ]
                          }
                        },
                        "required": [
                          "sentences",
                          "en"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "da"
                    ]
                  }
                }
              },
              "required": [
                "label",
                "question",
                "followUps"
              ]
            }
          },
          "secondQuestion": {
            "type": "object",
            "properties": {
              "question": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Stable id within the topic, e.g. 'q1-a', 'q1-a-f1', 'q2', 'q2-f1'"
                  },
                  "da": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact Danish wording from the examiner booklet"
                  },
                  "en": {
                    "description": "English translation",
                    "type": "string"
                  },
                  "answer": {
                    "type": "object",
                    "properties": {
                      "sentences": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": "Danish answer, one sentence per item"
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "description": "English translation of the whole answer"
                      },
                      "status": {
                        "default": "draft",
                        "description": "Set to 'reviewed' after the Danish reviewer has checked it",
                        "type": "string",
                        "enum": [
                          "draft",
                          "reviewed"
                        ]
                      }
                    },
                    "required": [
                      "sentences",
                      "en"
                    ]
                  }
                },
                "required": [
                  "id",
                  "da"
                ]
              },
              "followUps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Stable id within the topic, e.g. 'q1-a', 'q1-a-f1', 'q2', 'q2-f1'"
                    },
                    "da": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact Danish wording from the examiner booklet"
                    },
                    "en": {
                      "description": "English translation",
                      "type": "string"
                    },
                    "answer": {
                      "type": "object",
                      "properties": {
                        "sentences": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "Danish answer, one sentence per item"
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "description": "English translation of the whole answer"
                        },
                        "status": {
                          "default": "draft",
                          "description": "Set to 'reviewed' after the Danish reviewer has checked it",
                          "type": "string",
                          "enum": [
                            "draft",
                            "reviewed"
                          ]
                        }
                      },
                      "required": [
                        "sentences",
                        "en"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "da"
                  ]
                }
              }
            },
            "required": [
              "question",
              "followUps"
            ]
          }
        },
        "required": [
          "id",
          "letter",
          "title",
          "firstQuestion",
          "secondQuestion"
        ]
      }
    }
  },
  "required": [
    "id",
    "label",
    "format",
    "source",
    "topics"
  ],
  "title": "PD3 oral exam set",
  "description": "One exam term of Prøve i Dansk 3, mundtlig del (delprøve 2)."
}
